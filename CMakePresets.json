{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23
    },
    "configurePresets": [
        {
            "name": "bios-debug",
            "description": "Debug build for BIOS PC systems",
            "binaryDir": "${sourceDir}/build",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/bios.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "FIRMWARE_IS_BIOS": "ON"
            }
        },
        {
            "name": "bios-release",
            "description": "Release build for BIOS PC systems",
            "binaryDir": "${sourceDir}/release",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/bios.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "FIRMWARE_IS_BIOS": "ON"
            }
        },
        {
            "name": "uefi-debug",
            "description": "Debug build for UEFI PC systems",
            "binaryDir": "${sourceDir}/uefi-build",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/bios.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "FIRMWARE_IS_BIOS": "OFF"
            }
        },
        {
            "name": "uefi-release",
            "description": "Release build for UEFI PC systems",
            "binaryDir": "${sourceDir}/uefi-release",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/bios.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "FIRMWARE_IS_BIOS": "OFF"
            }
        }
    ]
}