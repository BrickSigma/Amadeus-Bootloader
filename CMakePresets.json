{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23
    },
    "configurePresets": [
        {
            "name": "bios-debug",
            "description": "Debug build for BIOS PC systems",
            "binaryDir": "${sourceDir}/bios-build",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/bios.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "FIRMWARE_IS_BIOS": "ON"
            }
        },
        {
            "name": "bios-release",
            "description": "Release build for BIOS PC systems",
            "binaryDir": "${sourceDir}/bios-release",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/bios.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "FIRMWARE_IS_BIOS": "ON"
            }
        },
        {
            "name": "uefi-ia-32-debug",
            "description": "Debug build for UEFI IA-32 PC systems",
            "binaryDir": "${sourceDir}/uefi-ia-32-build",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/uefi-ia-32.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "FIRMWARE_IS_BIOS": "OFF"
            }
        },
        {
            "name": "uefi-ia-32-release",
            "description": "Release build for UEFI IA-32 PC systems",
            "binaryDir": "${sourceDir}/uefi-ia-32-release",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/uefi-ia-32.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "FIRMWARE_IS_BIOS": "OFF"
            }
        },
        {
            "name": "uefi-x86_64-debug",
            "description": "Debug build for UEFI x86_64 PC systems",
            "binaryDir": "${sourceDir}/uefi-x86_64-build",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/uefi-x86_64.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "FIRMWARE_IS_BIOS": "OFF"
            }
        },
        {
            "name": "uefi-x86_64-release",
            "description": "Release build for UEFI x86_64 PC systems",
            "binaryDir": "${sourceDir}/uefi-x86_64-release",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/uefi-x86_64.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "FIRMWARE_IS_BIOS": "OFF"
            }
        }
    ]
}